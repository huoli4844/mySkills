{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "name",
      "file",
      "fm",
      "bd"
    ],
    "properties": {
      "name": {
        "type": "string"
      },
      "file": {
        "type": "string"
      },
      "fm": {
        "type": "object",
        "required": [
          "source_chapter",
          "confidence"
        ],
        "properties": {
          "source_chapter": {
            "type": "string"
          },
          "source_from": {
            "type": "string"
          },
          "confidence": {
            "type": "number"
          },
          "confidence_note": {
            "type": "string"
          }
        }
      },
      "bd": {
        "type": "object"
      }
    }
  }
}